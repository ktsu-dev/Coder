<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Drives the ImGui surface of Coder.Graph headlessly, through the CPU rasterizer. -->
    <PackageReference Include="ktsu.ImGui.App" />
    <PackageReference Include="ktsu.ImGui.App.Testing" />
    <!-- The editor tests drive the real filesystem provider the application ships with. -->
    <PackageReference Include="ktsu.Essentials.FileSystemProviders.Native" />
    <!-- The history tests assert against the undo stack's own command and metadata types. -->
    <PackageReference Include="ktsu.UndoRedo.Core" />
    <!-- The preview tests classify generated source with the same highlighter the pane draws it with. -->
    <PackageReference Include="ktsu.ImGui.SyntaxHighlighting" />
    <!-- The window-state tests name the windowing layer's own maximized state. -->
    <PackageReference Include="Silk.NET.Windowing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coder.Core\Coder.Core.csproj" />
    <ProjectReference Include="..\Coder.Graph\Coder.Graph.csproj" />
    <ProjectReference Include="..\Coder.Editor\Coder.Editor.csproj" />
  </ItemGroup>
</Project>
