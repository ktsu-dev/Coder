<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.ConsoleApp" />

  <PropertyGroup>
    <!-- A sample that demonstrates the library rather than part of the product, and it has no tests
         of its own: every line of it counts against SonarCloud's coverage gate while covering it
         proves nothing. Kept out of the analysis rather than left to drag the measurement down. -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Polyfill" PrivateAssets="all" /></ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coder\Coder.csproj" />
  </ItemGroup>
</Project>
