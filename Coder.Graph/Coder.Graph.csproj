<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <!-- ktsu.ImGui.NodeEditor ships net10.0 only, so this library cannot cross-target the way
         Coder does. Coder stays free of any UI dependency. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ktsu.ImGui.NodeEditor" />
    <!-- The physics settings the graph enables are this package's type, named directly rather than
         inherited through the node editor. -->
    <PackageReference Include="ktsu.ForceDirectedLayout" />
    <PackageReference Include="ktsu.UndoRedo.Core" />
    <!-- The inspector's properties are rows of this package's property grid. -->
    <PackageReference Include="ktsu.ImGui.Widgets" />
    <!-- The two rows the grid has no method for are marked for the probes the same way its own rows
         are, which is what lets a headless test find them. -->
    <PackageReference Include="ktsu.ImGui.Probes" />
    <PackageReference Include="Hexa.NET.ImGui" />
    <PackageReference Include="Hexa.NET.ImNodes" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coder\Coder.csproj" />
  </ItemGroup>
</Project>
